        .bill-row span { color: #8c939d; }
        .bill-row strong { color: #fff; font-size: 12.5px; }
        .bill-highlight { color: #54a9ff !important; font-size: 16px !important; }
        .copyable-text {
            cursor: pointer;
            transition: color 0.2s;
            border-bottom: 1px dashed #555;
            padding-bottom: 1px;
        }
        .copyable-text:hover { color: var(--blue2); border-color: var(--blue2); }
        .memo-highlight {
            color: #ffb86c !important;
            font-family: monospace;
            font-size: 13px !important;
        }
        .bill-footer-note p {
            font-size: 11px;
            color: #7c838d;
            line-height: 1.5;
            margin-bottom: 14px;
        }

        /* Tab 2: Booking Cards */
        .panel-head-flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 25px;
        }
        .panel-head-flex h3 {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 4px;
        }
        .panel-head-flex p {
            font-size: 13px;
            color: #8c939d;
        }
        .booking-filters {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }
        .filter-pill {
            background: #15181d;
            border: 1px solid #2a2e36;
            color: #8c939d;
            font-size: 11px;
            font-weight: 800;
            padding: 8px 14px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .filter-pill:hover, .filter-pill.active {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

        .booking-cards-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .booking-item-card {
            background: #14171d;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 24px;
            transition: border-color 0.2s, transform 0.2s;
        }
        .booking-item-card:hover {
            border-color: rgba(22, 112, 255, 0.4);
        }
        .booking-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding-bottom: 14px;
            margin-bottom: 16px;
        }
        .booking-meta-left {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .booking-code {
            font-family: monospace;
            font-size: 13px;
            font-weight: 800;
            color: var(--blue2);
            background: rgba(22, 112, 255, 0.1);
            padding: 4px 10px;
            border-radius: 4px;
        }
        .booking-date {
            font-size: 12px;
            color: #8c939d;
        }
        .booking-status-badge {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.08em;
            padding: 4px 12px;
            border-radius: 20px;
        }
        .status-confirmed { background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4); }
        .status-active { background: rgba(22, 112, 255, 0.2); color: var(--blue2); border: 1px solid var(--blue); }
        .status-completed { background: rgba(100, 116, 139, 0.2); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.4); }
        .status-cancelled { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }
        .status-pending { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }

        .booking-body-grid {
            display: grid;
            grid-template-columns: 1fr 1.5fr 1fr;
            gap: 20px;
            align-items: center;
        }
        .pc-badge {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .pc-icon {
            font-size: 26px;
        }
        .pc-badge strong {
            display: block;
            font-size: 16px;
            color: #fff;
        }
        .pc-badge small {
            color: #8c939d;
            font-size: 11px;
        }

        .booking-time-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            font-size: 12px;
        }
        .booking-time-info div {
            display: flex;
            gap: 8px;
        }
        .booking-time-info .lbl {
            color: #8c939d;
            font-weight: 700;
            width: 80px;
        }
        .booking-time-info strong {
            color: #e2e8f0;
        }

        .booking-price-info {
            text-align: right;
        }
        .booking-price-info small {
            display: block;
            font-size: 10px;
            font-weight: 800;
            color: #8c939d;
            letter-spacing: 0.08em;
            margin-bottom: 2px;
        }
        .booking-price-info strong {
            font-size: 18px;
            font-weight: 800;
            color: var(--blue2);
        }

        .booking-food-attached {
            margin-top: 14px;
            padding: 10px 14px;
            background: #0c0e12;
            border-radius: 6px;
            font-size: 12px;
            color: #d1d5db;
        }
        .food-label { font-weight: 800; color: #fbbf24; margin-right: 6px; }
        .food-price { color: #10b981; font-weight: 700; margin-left: 6px; }

        .booking-cancel-note {
            margin-top: 12px;
            font-size: 11.5px;
            color: #f87171;
            background: rgba(239, 68, 68, 0.08);
            padding: 8px 12px;
            border-radius: 6px;
        }

        .booking-actions-row {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 14px;
        }
        .btn-cancel-booking {
            background: transparent;
            border: 1px solid rgba(239, 68, 68, 0.5);
            color: #f87171;
            font-size: 11px;
            font-weight: 800;
            padding: 7px 14px;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-cancel-booking:hover {
            background: rgba(239, 68, 68, 0.2);
            color: #ff5c5c;
        }
        .btn-rebook {
            background: #1a1e24;
            border: 1px solid #38404a;
            color: #fff;
            font-size: 11px;
            font-weight: 800;
            padding: 7px 14px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: 0.2s;
        }
        .btn-rebook:hover {
            border-color: var(--blue);
            color: var(--blue2);
        }

        /* Tab 3: Profile Info Form */
        .profile-info-grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 30px;
        }
        .info-form-card {
            background: #14171d;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 30px;
        }
        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }
        .field-hint {
            display: block;
            font-size: 10px;
            color: #6b7280;
            margin-top: 4px;
        }
        .input-disabled {
            opacity: 0.6;
            cursor: not-allowed;
            background: #090a0d !important;
        }

        .member-benefits-card {
            background: #15181d;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 30px;
            height: fit-content;
        }
        .member-benefits-card h4 {
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: var(--blue2);
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 12px;
        }
        .benefits-list {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }
        .benefit-item {
            display: flex;
            gap: 14px;
            align-items: flex-start;
        }
        .benefit-item .icon {
            font-size: 22px;
            flex-shrink: 0;
            margin-top: 2px;
        }
        .benefit-item strong {
            display: block;
            font-size: 13px;
            color: #fff;
            margin-bottom: 2px;
        }
        .benefit-item p {
            font-size: 11.5px;
            color: #8c939d;
            line-height: 1.4;
        }

        /* Tab 4: Transactions Table */
        .transactions-table-wrap {
            background: #14171d;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            overflow-x: auto;
        }
        .cyber-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            text-align: left;
        }
        .cyber-table th {
            background: #1a1e24;
            padding: 14px 20px;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 0.1em;
            color: #8c939d;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .cyber-table td {
            padding: 16px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: #d1d5db;
        }
        .cyber-table tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }
        .mono-code {
            font-family: monospace;
            font-weight: 700;
            color: #94a3b8;
        }
        .trans-type-pill {
            font-size: 11px;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .trans-type-pill.plus { background: rgba(16, 185, 129, 0.15); color: #10b981; }
        .trans-type-pill.minus { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
        .amount-plus { color: #10b981; font-weight: 800; font-size: 14px; }
        .amount-minus { color: #f87171; font-weight: 800; font-size: 14px; }
        .badge-success {
            font-size: 10px;
            font-weight: 800;
            color: #10b981;
            background: rgba(16, 185, 129, 0.1);
            padding: 2px 8px;
            border-radius: 4px;
        }

        /* Empty State */
        .empty-state-box {
            background: #14171d;
            border: 1px dashed rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 60px 30px;
            text-align: center;
            max-width: 500px;
            margin: 40px auto;
        }
        .empty-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }
        .empty-state-box h4 {
            font-size: 16px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 8px;
        }
        .empty-state-box p {
            font-size: 13px;
            color: #8c939d;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        /* Toast Message */
        .cyber-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #1e2430;
            color: #fff;
            padding: 14px 24px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid var(--blue);
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            z-index: 10000;
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .cyber-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
        .cyber-toast.success { border-color: #10b981; }
        .cyber-toast.error { border-color: #ef4444; }

        .save-msg {
            font-size: 12px;
            font-weight: 700;
            margin-left: 15px;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .profile-header-card {
                grid-template-columns: 1fr;
            }
            .stats-overview-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .panel-grid-deposit {
                grid-template-columns: 1fr;
            }
            .profile-info-grid {
                grid-template-columns: 1fr;
            }
            .booking-body-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }
            .booking-price-info {
                text-align: left;
            }
        }
        @@media (max-width: 600px) {
            .profile-user-summary {
                flex-direction: column;
                text-align: center;
            }
            .user-meta-info {
                justify-content: center;
            }
            .stats-overview-grid {
                grid-template-columns: 1fr;
            }
            .form-row-2 {
                grid-template-columns: 1fr;
            }
            .quick-amounts-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
}

@section Scripts {
    <script>
        let currentSelectedAmount = 100000;
        let cancelPendingBookingId = null;

        document.addEventListener("DOMContentLoaded", () => {
            initDepositControls();
            
            // Check query param tab
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam) {
                switchTab(tabParam);
            }
        });

        function switchTab(tabName) {
            document.querySelectorAll(".tab-btn").forEach(btn => btn.classList.remove("active"));
            document.querySelectorAll(".tab-panel").forEach(panel => panel.classList.remove("active"));

            const targetBtn = Array.from(document.querySelectorAll(".tab-btn")).find(b => b.getAttribute("onclick")?.includes(tabName));
            if (targetBtn) targetBtn.classList.add("active");

            const targetPanel = document.getElementById("panel-" + tabName);
            if (targetPanel) targetPanel.classList.add("active");

            // Update URL without reload
            const newUrl = new URL(window.location);
            newUrl.searchParams.set('tab', tabName);
            window.history.replaceState({}, '', newUrl);

            window.scrollTo({ top: 320, behavior: 'smooth' });
        }

        function initDepositControls() {
            const chips = document.querySelectorAll(".amount-chip");
            const customInput = document.getElementById("customDepositAmount");

            chips.forEach(chip => {
                chip.addEventListener("click", function() {
                    chips.forEach(c => c.classList.remove("selected"));
                    this.classList.add("selected");
                    const amt = parseInt(this.getAttribute("data-amount"));
                    currentSelectedAmount = amt;
                    customInput.value = new Intl.NumberFormat('vi-VN').format(amt);
                    updateVietQrPreview();
                });
            });

            customInput.addEventListener("input", function() {
                chips.forEach(c => c.classList.remove("selected"));
                let val = this.value.replace(/[^0-9]/g, '');
                let num = parseInt(val) || 0;
                currentSelectedAmount = num;
                this.value = num > 0 ? new Intl.NumberFormat('vi-VN').format(num) : '';
                updateVietQrPreview();
            });

            document.querySelectorAll("input[name='payMethod']").forEach(radio => {
                radio.addEventListener("change", function() {
                    document.querySelectorAll(".pay-method-card").forEach(c => c.classList.remove("active"));
                    this.closest(".pay-method-card").classList.add("active");
                });
            });
        }

        function updateVietQrPreview() {
            const amtDisplay = document.getElementById("qrAmountDisplay");
            const qrImg = document.getElementById("dynamicQrImg");
            const amt = currentSelectedAmount > 0 ? currentSelectedAmount : 100000;

            if (amtDisplay) {
                amtDisplay.textContent = new Intl.NumberFormat('vi-VN').format(amt) + ' VNĐ';
            }

            const username = window.CURRENT_USERNAME || "@user.Username";
            const memo = `CG NAP ${username}`;
            const qrUrl = `https://img.vietqr.io/image/MB-0868889999-compact2.png?amount=${amt}&addInfo=${encodeURIComponent(memo)}&accountName=CYBERGAME%20STADIUM`;

            if (qrImg) {
                qrImg.src = qrUrl;
            }
        }

        function triggerShowQrCode() {
            updateVietQrPreview();
            const previewBox = document.querySelector(".deposit-preview-box");
            if (previewBox) {
                previewBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                showToast("Vui lòng quét mã QR bên dưới để nạp " + new Intl.NumberFormat('vi-VN').format(currentSelectedAmount) + " đ!", "success");
            }
        }

        async function confirmInstantDeposit() {
            if (currentSelectedAmount < 10000) {
                showToast("Số tiền nạp tối thiểu là 10.000 VNĐ.", "error");
                return;
            }

            const selectedMethodRadio = document.querySelector("input[name='payMethod']:checked");
            const methodId = selectedMethodRadio ? parseInt(selectedMethodRadio.value) : 2;

            const btn = document.getElementById("btnInstantDemoDeposit");
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = "⏳ Đang xử lý giao dịch...";

            try {
                const res = await fetch("/Account/Deposit", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        amount: currentSelectedAmount,
                        methodId: methodId,
                        note: "Nạp ví trực tuyến"
                    })
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, "success");

                    // Cập nhật số dư trên giao diện
                    if (data.newBalanceFormatted) {
                        const cardBal = document.getElementById("walletCardBalance");
                        const statBal = document.getElementById("statCurrentBalance");
                        const headerBal = document.getElementById("headerBalanceDisplay");

                        if (cardBal) cardBal.innerHTML = `${data.newBalance.toLocaleString('vi-VN')} <span class="currency">VNĐ</span>`;
                        if (statBal) statBal.textContent = data.newBalanceFormatted;
                        if (headerBal) headerBal.textContent = data.newBalanceFormatted;
                    }

                    // Tự động thêm bản ghi vào bảng giao dịch
                    const tbody = document.getElementById("transactionsTbody");
                    if (tbody) {
                        const tr = document.createElement("tr");
                        tr.innerHTML = `
                            <td><span class="mono-code">#TX-NEW</span></td>
                            <td><span class="trans-type-pill plus">📥 Nạp tiền ví</span></td>
                            <td><strong class="amount-plus">+${data.amount.toLocaleString('vi-VN')} đ</strong></td>
                            <td>${data.createdAt || "Vừa xong"}</td>
                            <td><span class="badge-success">Thành công</span></td>
                        `;
                        tbody.prepend(tr);
                    }
                } else {
                    showToast(data.message || "Giao dịch không thành công.", "error");
                }
            } catch (err) {
                showToast("Lỗi kết nối máy chủ: " + err.message, "error");
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        }

        async function handleUpdateProfile(e) {
            e.preventDefault();
            const phone = document.getElementById("profilePhone").value.trim();
            const email = document.getElementById("profileEmail").value.trim();
            const dob = document.getElementById("profileDob").value;
            const btn = document.getElementById("btnSaveProfile");
            const msgSpan = document.getElementById("profileSaveMsg");

            btn.disabled = true;
            btn.textContent = "⏳ Đang lưu...";
            msgSpan.textContent = "";

            try {
                const res = await fetch("/Account/UpdateProfile", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        phone: phone,
                        email: email,
                        dateOfBirth: dob ? dob : null
                    })
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, "success");
                    msgSpan.textContent = "✓ Đã lưu thành công!";
                    msgSpan.style.color = "#10b981";
                } else {
                    showToast(data.message, "error");
                    msgSpan.textContent = "✕ " + data.message;
                    msgSpan.style.color = "#ef4444";
                }
            } catch (err) {
                showToast("Lỗi lưu hồ sơ: " + err.message, "error");
            } finally {
                btn.disabled = false;
                btn.textContent = "💾 LƯU THAY ĐỔI";
            }
        }

        async function handleChangePassword(e) {
            e.preventDefault();
            const oldPass = document.getElementById("txtOldPassword").value;
            const newPass = document.getElementById("txtNewPassword").value;
            const confirmPass = document.getElementById("txtConfirmNewPassword").value;
            const btn = document.getElementById("btnChangePassword");
            const msgSpan = document.getElementById("passwordChangeMsg");

            if (newPass !== confirmPass) {
                showToast("Mật khẩu mới và xác nhận mật khẩu không khớp!", "error");
                return;
            }

            btn.disabled = true;
            btn.textContent = "⏳ Đang đổi mật khẩu...";
            msgSpan.textContent = "";

            try {
                const res = await fetch("/Account/ChangePassword", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        oldPassword: oldPass,
                        newPassword: newPass,
                        confirmNewPassword: confirmPass
                    })
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, "success");
                    msgSpan.textContent = "✓ " + data.message;
                    msgSpan.style.color = "#10b981";
                    document.getElementById("changePasswordForm").reset();
                } else {
                    showToast(data.message, "error");
                    msgSpan.textContent = "✕ " + data.message;
                    msgSpan.style.color = "#ef4444";
                }
            } catch (err) {
                showToast("Lỗi: " + err.message, "error");
            } finally {
                btn.disabled = false;
                btn.textContent = "🔒 CẬP NHẬT MẬT KHẨU MỚI";
            }
        }

        function filterBookings(cat, btn) {
            document.querySelectorAll(".filter-pill").forEach(p => p.classList.remove("active"));
            btn.classList.add("active");

            document.querySelectorAll(".booking-item-card").forEach(card => {
                if (cat === "all") {
                    card.style.display = "block";
                } else {
                    const cCat = card.getAttribute("data-category");
                    card.style.display = (cCat === cat) ? "block" : "none";
                }
            });
        }

        function openCancelModal(bookingId, compName) {
            cancelPendingBookingId = bookingId;
            const desc = document.getElementById("cancelModalDesc");
            if (desc) desc.textContent = `Bạn có chắc chắn muốn hủy đặt chỗ cho máy ${compName} (Mã #${bookingId})?`;
            const modal = document.getElementById("cancelBookingModal");
            if (modal) modal.style.display = "flex";
        }

        function closeCancelModal() {
            cancelPendingBookingId = null;
            const modal = document.getElementById("cancelBookingModal");
            if (modal) modal.style.display = "none";
        }

        async function executeCancelBooking() {
            if (!cancelPendingBookingId) return;

            const reason = document.getElementById("cancelReasonInput").value.trim();
            const btn = document.getElementById("btnConfirmCancel");
            btn.disabled = true;
            btn.textContent = "⏳ Đang hủy...";

            try {
                const res = await fetch("/Account/CancelBooking", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        bookingId: cancelPendingBookingId,
                        reason: reason
                    })
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, "success");
                    closeCancelModal();

                    // Cập nhật card trạng thái
                    const card = document.getElementById("bookingCard-" + cancelPendingBookingId);
                    if (card) {
                        const badge = card.querySelector(".booking-status-badge");
                        if (badge) {
                            badge.className = "booking-status-badge status-cancelled";
                            badge.textContent = "ĐÃ HỦY";
                        }
                        const cancelBtn = card.querySelector(".btn-cancel-booking");
                        if (cancelBtn) cancelBtn.remove();
                        card.setAttribute("data-category", "cancelled");
                    }
                } else {
                    showToast(data.message || "Hủy không thành công.", "error");
                }
            } catch (err) {
                showToast("Lỗi: " + err.message, "error");
            } finally {
                btn.disabled = false;
                btn.textContent = "ĐỒNG Ý HỦY";
            }
        }

        function copyToClipboard(text, successMsg) {
            navigator.clipboard.writeText(text).then(() => {
                showToast(successMsg || "Đã sao chép vào bộ nhớ tạm!", "success");
            }).catch(err => {
                showToast("Không thể sao chép: " + err, "error");
            });
        }

        function showToast(msg, type = "success") {
            const toast = document.getElementById("cyberToast");
            if (!toast) return;
            toast.className = `cyber-toast show ${type}`;
            toast.textContent = (type === "success" ? "✓ " : "✕ ") + msg;

            setTimeout(() => {
                toast.classList.remove("show");
            }, 3500);
        }
    </script>
}
