@model CyberGame.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân & Ví Cyber";
    var user = Model.User;
}

<div class="profile-page">
    <div class="profile-hero">
        <div class="container">
            <!-- Breadcrumb -->
            <div class="profile-breadcrumb">
                <a asp-controller="Home" asp-action="Index">TRANG CHỦ</a>
                <span>/</span>
                <span class="current">HỒ SƠ HỘI VIÊN & VÍ ĐIỆN TỬ</span>
            </div>

            <!-- Top Header Card -->
            <div class="profile-header-card">
                <div class="profile-user-summary">
                    <div class="profile-avatar">
                        <div class="avatar-glow"></div>
                        <span class="avatar-text">@(user.Username.Length > 2 ? user.Username.Substring(0, 2).ToUpper() : "CG")</span>
                        <span class="status-indicator online" title="Đang trực tuyến"></span>
                    </div>
                    <div class="profile-user-details">
                        <div class="badge-row">
                            <span class="member-tag @(user.Role == "admin" ? "admin" : "vip")">
                                @(user.Role == "admin" ? "👑 QUẢN TRỊ VIÊN" : "⚡ HỘI VIÊN CYBERGAME")
                            </span>
                            <span class="id-tag">ID: #CG-@user.UserId.ToString("D5")</span>
                        </div>
                        <h1 class="user-fullname">@user.Username</h1>
                        <p class="user-meta-info">
                            <span>📧 @(string.IsNullOrEmpty(user.Email) ? "Chưa cập nhật email" : user.Email)</span>
                            <span>📱 @(string.IsNullOrEmpty(user.Phone) ? "Chưa cập nhật SĐT" : user.Phone)</span>
                            <span>📅 Gia nhập: @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </p>
                    </div>
                </div>

                <!-- Holographic Cyber Wallet Card -->
                <div class="cyber-wallet-card">
                    <div class="card-glass-glow"></div>
                    <div class="card-head">
                        <div class="card-brand">
                            <span class="brand-chip"></span>
                            <b>CYBER<span>WALLET</span></b>
                        </div>
                        <span class="card-badge">PREMIUM PASS</span>
                    </div>
                    <div class="card-balance-block">
                        <small>SỐ DƯ KHẢ DỤNG</small>
                        <h2 class="card-balance" id="walletCardBalance">@user.Balance.ToString("N0") <span class="currency">VNĐ</span></h2>
                    </div>
                    <div class="card-footer">
                        <div class="card-number">•••• •••• •••• @user.UserId.ToString("D4")</div>
                        <button type="button" class="btn-card-topup" onclick="switchTab('wallet')">
                            <span>+</span> NẠP TIỀN
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quick Stats Row -->
            <div class="stats-overview-grid">
                <div class="stat-pill-card">
                    <div class="stat-icon-wrap blue">💳</div>
                    <div>
                        <small>SỐ DƯ HIỆN TẠI</small>
                        <strong id="statCurrentBalance">@user.Balance.ToString("N0") đ</strong>
                    </div>
                </div>
                <div class="stat-pill-card">
                    <div class="stat-icon-wrap green">📥</div>
                    <div>
                        <small>TỔNG ĐÃ NẠP VÍ</small>
                        <strong>@Model.TotalDeposited.ToString("N0") đ</strong>
                    </div>
                </div>
                <div class="stat-pill-card">
                    <div class="stat-icon-wrap purple">🖥️</div>
                    <div>
                        <small>LƯỢT ĐẶT MÁY</small>
                        <strong>@Model.TotalBookings Lượt</strong>
                    </div>
                </div>
                <div class="stat-pill-card">
                    <div class="stat-icon-wrap orange">🍔</div>
                    <div>
                        <small>TỔNG TIÊU DÙNG</small>
                        <strong>@Model.TotalSpent.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Tabs Section -->
    <div class="profile-content-section">
        <div class="container">
            <!-- Tab Buttons Bar -->
            <div class="profile-nav-tabs">
                <button type="button" class="tab-btn @(Model.ActiveTab == "wallet" ? "active" : "")" onclick="switchTab('wallet')">
                    <span class="tab-icon">💳</span>
                    <span class="tab-label">Nạp Tiền & Ví</span>
                </button>
                <button type="button" class="tab-btn @(Model.ActiveTab == "bookings" ? "active" : "")" onclick="switchTab('bookings')">
                    <span class="tab-icon">🖥️</span>
                    <span class="tab-label">Lịch Sử Đặt Máy</span>
                    @if (Model.Bookings.Any())
                    {
                        <span class="tab-counter">@Model.Bookings.Count</span>
                    }
                </button>
                <button type="button" class="tab-btn @(Model.ActiveTab == "info" ? "active" : "")" onclick="switchTab('info')">
                    <span class="tab-icon">👤</span>
                    <span class="tab-label">Thông Tin Cá Nhân</span>
                </button>
                <button type="button" class="tab-btn @(Model.ActiveTab == "transactions" ? "active" : "")" onclick="switchTab('transactions')">
                    <span class="tab-icon">📜</span>
                    <span class="tab-label">Biến Động Số Dư</span>
                    @if (Model.Transactions.Any())
                    {
                        <span class="tab-counter">@Model.Transactions.Count</span>
                    }
                </button>
                <button type="button" class="tab-btn @(Model.ActiveTab == "security" ? "active" : "")" onclick="switchTab('security')">
                    <span class="tab-icon">🔒</span>
                    <span class="tab-label">Bảo Mật & Mật Khẩu</span>
                </button>
            </div>

            <!-- Tab Panels Wrapper -->
            <div class="profile-tab-panels">

                <!-- ================= TAB 1: NẠP TIỀN & VÍ ================= -->
                <div class="tab-panel @(Model.ActiveTab == "wallet" ? "active" : "")" id="panel-wallet">
                    <div class="panel-grid-deposit">
                        <!-- Left: Deposit Controls -->
                        <div class="deposit-form-box">
                            <div class="panel-head">
                                <h3>NẠP TIỀN VÀO TÀI KHOẢN</h3>
                                <p>Nạp tiền tự động qua VietQR hoặc Ví điện tử để sẵn sàng đặt máy và gọi món F&B 24/7.</p>
                            </div>

                            <!-- Fast Amount Selector -->
                            <div class="form-section">
                                <label class="section-title">1. Chọn mức nạp nhanh:</label>
                                <div class="quick-amounts-grid">
                                    <button type="button" class="amount-chip" data-amount="50000">50.000 đ</button>
                                    <button type="button" class="amount-chip selected" data-amount="100000">
                                        100.000 đ
                                        <span class="chip-hot">HOT</span>
                                    </button>
                                    <button type="button" class="amount-chip" data-amount="200000">200.000 đ</button>
                                    <button type="button" class="amount-chip" data-amount="500000">
                                        500.000 đ
                                        <span class="chip-bonus">+10% GIỜ</span>
                                    </button>
                                    <button type="button" class="amount-chip" data-amount="1000000">1.000.000 đ</button>
                                    <button type="button" class="amount-chip" data-amount="2000000">2.000.000 đ</button>
                                </div>
                            </div>

                            <!-- Custom Amount Input -->
                            <div class="form-section">
                                <label class="section-title" for="customDepositAmount">Hoặc nhập số tiền mong muốn (Tối thiểu 10.000 đ):</label>
                                <div class="amount-input-wrap">
                                    <input type="text" id="customDepositAmount" value="100.000" placeholder="Nhập số tiền..." />
                                    <span class="amount-unit">VNĐ</span>
                                </div>
                            </div>

                            <!-- Payment Method Selector -->
                            <div class="form-section">
                                <label class="section-title">2. Chọn phương thức nạp tiền:</label>
                                <div class="payment-methods-list">
                                    <label class="pay-method-card active">
                                        <input type="radio" name="payMethod" value="2" data-code="BANK_QR" checked />
                                        <div class="method-icon-box vietqr">
                                            <span>VietQR</span>
                                        </div>
                                        <div class="method-info">
                                            <strong>Chuyển khoản Ngân hàng (VietQR 24/7)</strong>
                                            <small>Quét mã QR tự động bằng mọi app ngân hàng (MB, VCB, Techcom, BIDV...) • Khuyên dùng</small>
                                        </div>
                                        <span class="method-tag free">TỰ ĐỘNG</span>
                                    </label>

                                    <label class="pay-method-card">
                                        <input type="radio" name="payMethod" value="1" data-code="CASH" />
                                        <div class="method-icon-box cash">
                                            <span>TIỀN MẶT</span>
                                        </div>
                                        <div class="method-info">
                                            <strong>Nạp tiền mặt trực tiếp tại quầy</strong>
                                            <small>Nộp tiền tại quầy lễ tân CyberGame Stadium để nhân viên cộng tiền vào ví</small>
                                        </div>
                                        <span class="method-tag instant">TẠI QUẦY</span>
                                    </label>
                                </div>
                            </div>

                            <div class="deposit-action-btns">
                                <button type="button" class="btn blue block" id="btnOpenQrModal" onclick="triggerShowQrCode()">
                                    ⚡ QUÉT MÃ QR NẠP TIỀN
                                </button>
                                <button type="button" class="btn outline block" id="btnInstantDemoDeposit" onclick="confirmInstantDeposit()">
                                    ✨ NẠP THỬ NGHIỆM TRỰC TIẾP (DEMO TEST)
                                </button>
                            </div>
                        </div>

                        <!-- Right: Live VietQR Invoice Preview Box -->
                        <div class="deposit-preview-box">
                            <div class="qr-bill-card">
                                <div class="bill-header">
                                    <div class="bill-brand">
                                        <span class="mark">CG</span>
                                        <b>CYBER<span>GAME</span> VIETQR</b>
                                    </div>
                                    <span class="bill-status-pill">CHỜ THANH TOÁN</span>
                                </div>

                                <div class="qr-image-container">
                                    <img id="dynamicQrImg" src="https://img.vietqr.io/image/MB-0868889999-compact2.png?amount=100000&addInfo=CG%20NAP%20@(user.Username)&accountName=CYBERGAME%20STADIUM" alt="Mã VietQR nạp tiền" />
                                    <div class="qr-scan-guide">
                                        <small>Mở ứng dụng Ngân hàng hoặc MoMo để quét mã</small>
                                    </div>
                                </div>

                                <div class="bill-details-list">
                                    <div class="bill-row">
                                        <span>Ngân hàng thụ hưởng:</span>
                                        <strong>MB Bank (Ngân Hàng Quân Đội)</strong>
                                    </div>
                                    <div class="bill-row">
                                        <span>Số tài khoản:</span>
                                        <strong class="copyable-text" onclick="copyToClipboard('0868889999', 'Đã sao chép số tài khoản!')">
                                            <span id="qrStkText">0868889999</span> 📋
                                        </strong>
                                    </div>
                                    <div class="bill-row">
                                        <span>Tên chủ tài khoản:</span>
                                        <strong>CYBERGAME STADIUM</strong>
                                    </div>
                                    <div class="bill-row">
                                        <span>Số tiền nạp:</span>
                                        <strong class="bill-highlight" id="qrAmountDisplay">100.000 VNĐ</strong>
                                    </div>
                                    <div class="bill-row">
                                        <span>Nội dung chuyển khoản:</span>
                                        <strong class="copyable-text memo-highlight" onclick="copyToClipboard(document.getElementById('qrMemoText').textContent, 'Đã sao chép nội dung!')">
                                            <span id="qrMemoText">CG NAP @user.Username</span> 📋
                                        </strong>
                                    </div>
                                </div>

                                <div class="bill-footer-note">
                                    <p>💡 Tiền sẽ được cộng tự động vào tài khoản ngay sau khi hệ thống nhận được giao dịch. Nếu quá 3 phút chưa thấy tiền vào ví, vui lòng bấm nút bên dưới.</p>
                                    <button type="button" class="btn blue btn-sm block" onclick="confirmInstantDeposit()">
                                        ✓ XÁC NHẬN ĐÃ CHUYỂN KHOẢN (HOÀN TẤT NẠP)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= TAB 2: LỊCH SỬ ĐẶT MÁY ================= -->
                <div class="tab-panel @(Model.ActiveTab == "bookings" ? "active" : "")" id="panel-bookings">
                    <div class="bookings-history-wrapper">
                        <div class="panel-head-flex">
                            <div>
                                <h3>LỊCH SỬ ĐẶT MÁY GAMING</h3>
                                <p>Theo dõi danh sách các lượt đặt máy của bạn tại CyberGame Stadium.</p>
                            </div>
                            <div class="booking-filters">
                                <button type="button" class="filter-pill active" onclick="filterBookings('all', this)">Tất cả (@Model.Bookings.Count)</button>
                                <button type="button" class="filter-pill" onclick="filterBookings('upcoming', this)">Sắp tới / Chờ chơi</button>
                                <button type="button" class="filter-pill" onclick="filterBookings('completed', this)">Đã hoàn thành</button>
                                <button type="button" class="filter-pill" onclick="filterBookings('cancelled', this)">Đã hủy</button>
                                <a asp-controller="Home" asp-action="Booking" class="btn blue btn-sm" style="margin-left:auto">+ ĐẶT THÊM MÁY</a>
                            </div>
                        </div>

                        @if (!Model.Bookings.Any())
                        {
                            <div class="empty-state-box">
                                <div class="empty-icon">🎮</div>
                                <h4>BẠN CHƯA CÓ LƯỢT ĐẶT MÁY NÀO</h4>
                                <p>Hãy chọn khu vực máy yêu thích, trải nghiệm cấu hình đỉnh cao RTX 4080 cùng bạn bè ngay hôm nay!</p>
                                <a asp-controller="Home" asp-action="Booking" class="btn blue">ĐẶT MÁY NGAY BÂY GIỜ →</a>
                            </div>
                        }
                        else
                        {
                            <div class="booking-cards-list">
                                @foreach (var b in Model.Bookings)
                                {
                                    string statusClass = b.Status switch
                                    {
                                        "confirmed" => "status-confirmed",
                                        "active" => "status-active",
                                        "completed" => "status-completed",
                                        "cancelled" => "status-cancelled",
                                        _ => "status-pending"
                                    };

                                    string statusText = b.Status switch
                                    {
                                        "confirmed" => "ĐÃ XÁC NHẬN",
                                        "active" => "ĐANG CHƠI",
                                        "completed" => "ĐÃ HOÀN THÀNH",
                                        "cancelled" => "ĐÃ HỦY",
                                        _ => "CHỜ DUYỆT"
                                    };

                                    string filterCategory = (b.Status == "confirmed" || b.Status == "pending" || b.Status == "active") ? "upcoming" : b.Status;

                                    <div class="booking-item-card" data-category="@filterCategory" id="bookingCard-@b.BookingId">
                                        <div class="booking-header">
                                            <div class="booking-meta-left">
                                                <span class="booking-code">#BK-@b.BookingId.ToString("D5")</span>
                                                <span class="booking-date">📅 Đặt lúc: @b.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                            <span class="booking-status-badge @statusClass">@statusText</span>
                                        </div>

                                        <div class="booking-body-grid">
                                            <div class="booking-pc-info">
                                                <div class="pc-badge">
                                                    <span class="pc-icon">🖥️</span>
                                                    <div>
                                                        <strong>MÁY @b.ComputerName</strong>
                                                        <small>@b.ZoneName (@b.PricePerHour.ToString("N0") đ/h)</small>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="booking-time-info">
                                                <div>
                                                    <span class="lbl">BẮT ĐẦU:</span>
                                                    <strong>@b.StartTime.ToString("dd/MM/yyyy HH:mm")</strong>
                                                </div>
                                                <div>
                                                    <span class="lbl">KẾT THÚC:</span>
                                                    <strong>@(b.EndTime.HasValue ? b.EndTime.Value.ToString("dd/MM/yyyy HH:mm") : "--")</strong>
                                                </div>
                                                <div>
                                                    <span class="lbl">THỜI LƯỢNG:</span>
                                                    <strong>@b.DurationHours giờ</strong>
                                                </div>
                                            </div>

                                            <div class="booking-price-info">
                                                <small>ƯỚC TÍNH TIỀN MÁY</small>
                                                <strong>@b.EstimatedCost.ToString("N0") đ</strong>
                                            </div>
                                        </div>

                                        @if (b.FoodItems != null && b.FoodItems.Any())
                                        {
                                            <div class="booking-food-attached">
                                                <span class="food-label">🍔 Dịch vụ F&B kèm theo:</span>
                                                <span class="food-list">@string.Join(" • ", b.FoodItems)</span>
                                                @if (b.FoodTotal > 0)
                                                {
                                                    <span class="food-price">(+@b.FoodTotal.ToString("N0") đ)</span>
                                                }
                                            </div>
                                        }

                                        @if (b.Status == "cancelled" && !string.IsNullOrEmpty(b.CancelReason))
                                        {
                                            <div class="booking-cancel-note">
                                                <span>Lý do hủy:</span> @b.CancelReason
                                                @if (b.CancelledAt.HasValue)
                                                {
                                                    <small>(Lúc: @b.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</small>
                                                }
                                            </div>
                                        }

                                        <div class="booking-actions-row">
                                            @if (b.CanCancel)
                                            {
                                                <button type="button" class="btn-cancel-booking" onclick="openCancelModal(@b.BookingId, '@b.ComputerName')">
                                                    ✕ HỦY ĐẶT CHỖ
                                                </button>
                                            }
                                            <a asp-controller="Home" asp-action="Booking" class="btn-rebook">
                                                🔄 ĐẶT LẠI MÁY NÀY
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- ================= TAB 3: THÔNG TIN CÁ NHÂN ================= -->
                <div class="tab-panel @(Model.ActiveTab == "info" ? "active" : "")" id="panel-info">
                    <div class="profile-info-grid">
                        <div class="info-form-card">
                            <div class="panel-head">
                                <h3>THÔNG TIN HỘI VIÊN</h3>
                                <p>Cập nhật số điện thoại và email để nhận thông báo khuyến mãi và quản lý đơn đặt máy.</p>
                            </div>

                            <form id="profileUpdateForm" onsubmit="handleUpdateProfile(event)">
                                <div class="form-row-2">
                                    <div class="form-group">
                                        <label>Tên đăng nhập (Username)</label>
                                        <input type="text" value="@user.Username" disabled class="input-disabled" />
                                        <small class="field-hint">Tên đăng nhập cố định, không thể thay đổi.</small>
                                    </div>
                                    <div class="form-group">
                                        <label>Mã hội viên (Account ID)</label>
                                        <input type="text" value="CG-@user.UserId.ToString("D5")" disabled class="input-disabled" />
                                    </div>
                                </div>

                                <div class="form-row-2">
                                    <div class="form-group">
                                        <label for="profilePhone">Số điện thoại liên hệ *</label>
                                        <input type="tel" id="profilePhone" value="@user.Phone" placeholder="090 123 4567" required />
                                    </div>
                                    <div class="form-group">
                                        <label for="profileEmail">Địa chỉ Email *</label>
                                        <input type="email" id="profileEmail" value="@user.Email" placeholder="game@cybergame.vn" required />
                                    </div>
                                </div>

                                <div class="form-row-2">
                                    <div class="form-group">
                                        <label for="profileDob">Ngày sinh</label>
                                        <input type="date" id="profileDob" value="@(user.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")" />
                                        <small class="field-hint">Nhận quà tặng và giờ chơi miễn phí vào ngày sinh nhật.</small>
                                    </div>
                                    <div class="form-group">
                                        <label>Vai trò hệ thống</label>
                                        <input type="text" value="@(user.Role == "admin" ? "Quản trị viên (Admin)" : "Thành viên chính thức (Member)")" disabled class="input-disabled" />
                                    </div>
                                </div>

                                <div class="form-actions mt-4">
                                    <button type="submit" class="btn blue" id="btnSaveProfile">
                                        💾 LƯU THAY ĐỔI
                                    </button>
                                    <span id="profileSaveMsg" class="save-msg"></span>
                                </div>
                            </form>
                        </div>

                        <!-- Sidebar Right: Member Benefits -->
                        <div class="member-benefits-card">
                            <h4>QUYỀN LỢI HỘI VIÊN CYBERGAME</h4>
                            <div class="benefits-list">
                                <div class="benefit-item">
                                    <span class="icon">🎟️</span>
                                    <div>
                                        <strong>Giữ máy trước 24/7</strong>
                                        <p>Được đặt chỗ online trước tối đa 3 ngày không lo hết máy giờ cao điểm.</p>
                                    </div>
                                </div>
                                <div class="benefit-item">
                                    <span class="icon">🍔</span>
                                    <div>
                                        <strong>Gọi món tận máy</strong>
                                        <p>Menu Bếp F&B phục vụ tận chỗ ngồi không làm gián đoạn trận đấu.</p>
                                    </div>
                                </div>
                                <div class="benefit-item">
                                    <span class="icon">🎁</span>
                                    <div>
                                        <strong>Tích lũy nạp ví</strong>
                                        <p>Nạp từ 200.000 đ nhận thêm giờ chơi khuyến mãi độc quyền.</p>
                                    </div>
                                </div>
                                <div class="benefit-item">
                                    <span class="icon">🎧</span>
                                    <div>
                                        <strong>Hỗ trợ kỹ thuật 1-1</strong>
                                        <p>Kết nối trực tiếp với Quản Trị Viên khi cần hỗ trợ cài game, đổi gear.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= TAB 4: BIẾN ĐỘNG SỐ DƯ ================= -->
                <div class="tab-panel @(Model.ActiveTab == "transactions" ? "active" : "")" id="panel-transactions">
                    <div class="transactions-wrapper">
                        <div class="panel-head-flex">
                            <div>
                                <h3>LỊCH SỬ GIAO DỊCH VÍ</h3>
                                <p>Xem toàn bộ biến động nạp tiền, thanh toán đặt máy và đơn gọi món F&B.</p>
                            </div>
                            <button type="button" class="btn outline btn-sm" onclick="switchTab('wallet')">
                                + NẠP TIỀN VÍ
                            </button>
                        </div>

                        @if (!Model.Transactions.Any())
                        {
                            <div class="empty-state-box">
                                <div class="empty-icon">📜</div>
                                <h4>CHƯA CÓ GIAO DỊCH NÀO</h4>
                                <p>Lịch sử biến động số dư sẽ được hiển thị khi bạn nạp tiền hoặc đặt dịch vụ tại phòng máy.</p>
                                <button type="button" class="btn blue" onclick="switchTab('wallet')">NẠP TIỀN VÍ NGAY</button>
                            </div>
                        }
                        else
                        {
                            <div class="transactions-table-wrap">
                                <table class="cyber-table">
                                    <thead>
                                        <tr>
                                            <th>MÃ GD</th>
                                            <th>LOẠI GIAO DỊCH</th>
                                            <th>SỐ TIỀN</th>
                                            <th>THỜI GIAN</th>
                                            <th>TRẠNG THÁI</th>
                                        </tr>
                                    </thead>
                                    <tbody id="transactionsTbody">
                                        @foreach (var t in Model.Transactions)
                                        {
                                            <tr>
                                                <td><span class="mono-code">#TX-@t.TransactionId.ToString("D5")</span></td>
                                                <td>
                                                    <span class="trans-type-pill @(t.IsPositive ? "plus" : "minus")">
                                                        @(t.IsPositive ? "📥" : "📤") @t.TypeDisplay
                                                    </span>
                                                </td>
                                                <td>
                                                    <strong class="@(t.IsPositive ? "amount-plus" : "amount-minus")">
                                                        @(t.IsPositive ? "+" : "-")@t.Amount.ToString("N0") đ
                                                    </strong>
                                                </td>
                                                <td>@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                                <td><span class="badge-success">Thành công</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- ================= TAB 5: BẢO MẬT & ĐỔI MẬT KHẨU ================= -->
                <div class="tab-panel @(Model.ActiveTab == "security" ? "active" : "")" id="panel-security">
                    <div class="security-box-wrapper">
                        <div class="info-form-card" style="max-width:540px;margin:auto">
                            <div class="panel-head">
                                <h3>ĐỔI MẬT KHẨU TÀI KHOẢN</h3>
                                <p>Nên sử dụng mật khẩu mạnh gồm chữ hoa, chữ thường và số để bảo vệ tài khoản của bạn.</p>
                            </div>

                            <form id="changePasswordForm" onsubmit="handleChangePassword(event)">
                                <div class="form-group">
                                    <label for="txtOldPassword">Mật khẩu hiện tại *</label>
                                    <input type="password" id="txtOldPassword" placeholder="Nhập mật khẩu đang dùng..." required />
                                </div>

                                <div class="form-group">
                                    <label for="txtNewPassword">Mật khẩu mới (Tối thiểu 6 ký tự) *</label>
                                    <input type="password" id="txtNewPassword" minlength="6" placeholder="Nhập mật khẩu mới..." required />
                                </div>

                                <div class="form-group">
                                    <label for="txtConfirmNewPassword">Xác nhận mật khẩu mới *</label>
                                    <input type="password" id="txtConfirmNewPassword" minlength="6" placeholder="Nhập lại mật khẩu mới..." required />
                                </div>

                                <div class="form-actions mt-4">
                                    <button type="submit" class="btn blue block" id="btnChangePassword">
                                        🔒 CẬP NHẬT MẬT KHẨU MỚI
                                    </button>
                                    <span id="passwordChangeMsg" class="save-msg"></span>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- MODAL HỦY ĐẶT CHỖ -->
<div class="modal" id="cancelBookingModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:9999;align-items:center;justify-content:center">
    <div class="modal-box" style="background:#15181d;border:1px solid #ff4d4f;border-radius:12px;padding:35px 25px;max-width:440px;width:90%;text-align:center;position:relative">
        <button class="close" onclick="closeCancelModal()" style="position:absolute;top:15px;right:20px;background:none;border:none;color:#fff;font-size:22px;cursor:pointer">×</button>
        <p class="eyebrow" style="color:#ff4d4f">HỦY ĐẶT MÁY</p>
        <h2 style="font-size:22px;margin:10px 0;color:#fff">XÁC NHẬN HỦY CHỖ?</h2>
        <p style="color:#a1aab5;font-size:13px;line-height:1.6" id="cancelModalDesc">
            Bạn có chắc chắn muốn hủy đặt chỗ này? Máy sẽ được chuyển sang trạng thái trống cho người khác đặt.
        </p>
        <div class="form-group" style="text-align:left;margin:18px 0">
            <label style="font-size:11px;color:#8c939d">Lý do hủy (tùy chọn):</label>
            <input type="text" id="cancelReasonInput" placeholder="Ví dụ: Bận đột xuất, đổi giờ..." style="width:100%;padding:10px;background:#0c0e12;border:1px solid #2a2e36;color:#fff;border-radius:6px" />
        </div>
        <div style="display:flex;gap:12px;justify-content:center">
            <button type="button" class="btn outline" onclick="closeCancelModal()" style="flex:1">KHÔNG HỦY</button>
            <button type="button" class="btn" style="background:#ef4444;color:#fff;flex:1" id="btnConfirmCancel" onclick="executeCancelBooking()">ĐỒNG Ý HỦY</button>
        </div>
    </div>
</div>

<!-- TOAST THÔNG BÁO -->
<div id="cyberToast" class="cyber-toast"></div>

@section Styles {
