@model CyberGame.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Trang chủ - Hệ thống CyberGame đẳng cấp";
}

<main>
<section class="hero" id="home"><div class="container"><div class="hero-copy reveal"><p class="eyebrow">NEXT LEVEL GAMING EXPERIENCE</p><h1>TRẢI NGHIỆM<br><span>KHÔNG GIỚI HẠN</span></h1><p class="desc">Không gian gaming hiện đại, cấu hình mạnh mẽ và dịch vụ chuyên nghiệp dành cho cộng đồng game thủ.</p><div class="actions"><a class="btn blue" href="#cybers">KHÁM PHÁ CYBER →</a><a class="btn outline" href="#about">VỀ CHÚNG TÔI</a></div></div></div><div class="scroll">SCROLL ↓</div></section>

<section class="intro" id="about"><div class="container two"><div class="reveal"><span class="num">01</span><p class="eyebrow">HỆ SINH THÁI GAMING</p><h2 class="title">KHÔNG CHỈ LÀ<br><span>MỘT PHÒNG GAME</span></h2></div><div class="intro-copy reveal"><p class="lead">Chúng tôi xây dựng hệ sinh thái gaming toàn diện, nơi game thủ có thể chơi, kết nối, thi đấu và tận hưởng trải nghiệm công nghệ mới.</p><p>Từ phòng máy tiêu chuẩn đến không gian thi đấu chuyên nghiệp, Cyber Game tập trung vào chất lượng thiết bị, không gian và trải nghiệm khách hàng.</p><a class="link" asp-controller="Home" asp-action="Cyber">KHÁM PHÁ HỆ THỐNG ↗</a></div></div></section>

<!-- DYNAMIC STATS FROM DATABASE -->
<section class="stats"><div class="container stats-grid">
  <div class="stat"><strong data-count="@Model.TotalZones">@Model.TotalZones</strong><small>KHU VỰC MÁY</small></div>
  <div class="stat"><strong data-count="@Model.TotalComputers">@Model.TotalComputers</strong><small>MÁY GAMING</small></div>
  <div class="stat"><strong data-count="@Model.TotalEquipment">@Model.TotalEquipment</strong><small>THIẾT BỊ / GEAR</small></div>
  <div class="stat"><strong data-count="100">100</strong><small>% CHẤT LƯỢNG</small></div>
</div></section>

<!-- DYNAMIC ZONES LIST FROM DATABASE -->
<section class="light" id="cybers"><div class="container">
  <div class="section-head reveal">
    <div><span class="num">02</span><p class="eyebrow">HỆ THỐNG PHÒNG MÁY</p><h2 class="title">ĐIỂM ĐẾN CỦA<br><span>GAME THỦ</span></h2></div>
    <p class="section-desc">Hệ thống máy được đầu tư bài bản, cấu hình chuẩn Esports đáp ứng mọi tựa game đỉnh cao.</p>
  </div>
  
  <div class="cybers" id="cyberList">
    @if (Model.Zones != null && Model.Zones.Any())
    {
        @foreach (var zone in Model.Zones)
        {
            var zoneImg = zone.ZoneName.Contains("VIP") 
                ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=800&q=80"
                : zone.ZoneName.Contains("Stream") || zone.ZoneName.Contains("Thi Đấu")
                ? "https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=800&q=80"
                : zone.ZoneName.Contains("Đôi") || zone.ZoneName.Contains("Couple")
                ? "https://images.unsplash.com/photo-1598550476439-6847785fcea6?auto=format&fit=crop&w=800&q=80"
                : "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=800&q=80";

            <article class="cyber-card">
              <div class="thumb" style="background-image:url('@zoneImg')">
                <span class="badge" style="position:absolute;top:15px;right:15px;background:rgba(0,0,0,0.7);color:var(--blue);border:1px solid var(--blue);padding:4px 10px;border-radius:4px;font-size:12px;font-weight:700">@zone.PricePerHour.ToString("N0") đ/h</span>
              </div>
              <div class="body">
                <h3 class="name">@zone.ZoneName</h3>
                <p class="meta" style="color:var(--text-muted);font-size:13px;margin:8px 0 12px">Quy mô: <strong>@zone.Computers.Count máy tính</strong> | Trạng thái: <span style="color:#10b981">Sẵn sàng</span></p>
                <p class="specs-preview" style="font-size:13px;line-height:1.5;color:#c1c7cd;margin-bottom:15px">@zone.Specs</p>
                <div class="cyber-actions" style="display:flex;gap:10px;margin-top:auto">
                  <a class="btn blue" asp-controller="Home" asp-action="Booking" asp-route-zoneId="@zone.ZoneId" style="flex:1;text-align:center">ĐẶT CHỖ →</a>
                  <a class="btn outline" asp-controller="Home" asp-action="CyberDetail" asp-route-id="@zone.ZoneId">CHI TIẾT</a>
                </div>
              </div>
            </article>
        }
    }
  </div>
  <div style="text-align:center;margin-top:38px"><a class="btn dark" asp-controller="Home" asp-action="Cyber">XEM TẤT CẢ PHÒNG MÁY →</a></div>
</div></section>

<!-- GAMES SECTION -->
<section class="games" id="games"><div class="container">
  <div class="section-head reveal"><div><span class="num">03</span><p class="eyebrow">TRÒ CHƠI</p><h2 class="title">SẴN SÀNG<br><span>CHIẾN ĐẤU</span></h2></div><a class="link" asp-controller="Home" asp-action="Games">XEM DANH SÁCH GAME ↗</a></div>
  <div class="game-grid" id="gameGrid"></div>
</div></section>

<!-- FEATURED FOODS FROM DATABASE -->
<section class="light" id="featuredFood" style="padding:60px 0;background:#0d1015"><div class="container">
  <div class="section-head reveal">
    <div><span class="num">04</span><p class="eyebrow">FOOD & DRINK</p><h2 class="title">THỰC ĐƠN<br><span>NẠP NĂNG LƯỢNG</span></h2></div>
    <a class="link" asp-controller="Home" asp-action="Menu">XEM TOÀN BỘ MENU ↗</a>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px;margin-top:30px">
    @foreach (var food in Model.FeaturedFoods)
    {
        <div style="background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden;display:flex;flex-direction:column">
          <div style="height:160px;background-image:url('@food.ImageUrl');background-size:cover;background-position:center;position:relative">
            <span style="position:absolute;top:10px;left:10px;background:rgba(0,0,0,0.7);color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:4px;text-transform:uppercase">@food.Category</span>
          </div>
          <div style="padding:15px;display:flex;flex-direction:column;flex:1">
            <h4 style="font-size:16px;color:#fff;margin-bottom:8px">@food.Name</h4>
            <div style="margin-top:auto;display:flex;justify-content:space-between;align-items:center;padding-top:10px;border-top:1px solid rgba(255,255,255,0.05)">
              <span style="color:var(--blue);font-weight:700;font-size:15px">@food.Price.ToString("N0") đ</span>
              <a asp-controller="Home" asp-action="Menu" class="btn blue" style="padding:6px 12px;font-size:12px">GỌI MÓN</a>
            </div>
          </div>
        </div>
    }
  </div>
</div></section>

<!-- DYNAMIC NEWS & KNOWLEDGE FROM DATABASE -->
<section class="light" id="news"><div class="container">
  <div class="section-head reveal"><div><span class="num">05</span><p class="eyebrow">TIN TỨC & HƯỚNG DẪN</p><h2 class="title">CẬP NHẬT<br><span>MỚI NHẤT</span></h2></div><a class="link" asp-controller="Home" asp-action="News">XEM TẤT CẢ ↗</a></div>
  <div class="news-grid" id="newsGrid">
    @foreach (var item in Model.NewsList)
    {
        var snippet = item.Answer.Length > 120 ? item.Answer.Substring(0, 120) + "..." : item.Answer;
        <article class="news-card">
          <div class="thumb" style="background-image:url('https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=600&q=80');height:180px;background-size:cover;background-position:center;position:relative">
            <span class="badge" style="position:absolute;top:10px;right:10px;background:var(--blue);color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700">@item.Category</span>
          </div>
          <div class="body" style="padding:20px">
            <span class="date" style="color:var(--text-muted);font-size:12px">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
            <h3 class="title" style="font-size:17px;margin:8px 0;line-height:1.4"><a asp-controller="Home" asp-action="NewsDetail" asp-route-id="@item.KnowledgeId" style="color:#fff;text-decoration:none">@item.Question</a></h3>
            <p class="desc" style="color:#9299a4;font-size:13px;line-height:1.6">@snippet</p>
            <a class="more" asp-controller="Home" asp-action="NewsDetail" asp-route-id="@item.KnowledgeId" style="display:inline-block;margin-top:12px;color:var(--blue);font-size:12px;font-weight:700;text-decoration:none">CHI TIẾT →</a>
          </div>
        </article>
    }
  </div>
</div></section>
</main>
