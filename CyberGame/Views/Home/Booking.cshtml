@model CyberGame.Models.ViewModels.BookingPageViewModel
@{
    ViewData["Title"] = "Đặt Máy | Cyber Game";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/dark.css">
}

<script>
    // Dữ liệu đồng bộ từ CSDL SQL Server sang Client-side
    window.DB_ZONES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Zones?.Select(z => new {
        id = z.ZoneId,
        name = z.ZoneName,
        price = (int)z.PricePerHour,
        specs = z.Specs,
        prefix = z.ZoneId == 1 ? "S" : (z.ZoneId == 2 ? "V" : (z.ZoneId == 3 ? "P" : (z.ZoneId == 4 ? "R" : "M"))),
        max = z.Computers.Count > 0 ? z.Computers.Count : 40,
        computers = z.Computers.OrderBy(c => c.ComputerName).Select(c => new {
            id = c.ComputerId,
            name = c.ComputerName,
            status = c.Status
        })
    })));

    window.DB_FOODS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Foods?.Select(f => new {
        id = f.FoodId.ToString(),
        name = f.Name,
        price = (int)f.Price,
        category = f.Category,
        image = !string.IsNullOrEmpty(f.ImageUrl) ? f.ImageUrl : "https://images.unsplash.com/photo-1612929633738-8fe44f7ec841?auto=format&fit=crop&w=400&q=80"
    })));
</script>

<main id="bookingPage">
  <section class="booking-section">
    <div class="container">
      <form id="bookingForm" class="booking-form">
        <div class="section-head reveal" style="justify-content: center; text-align: center; margin-bottom: 40px; width: 100%;">
          <div>
            <p class="eyebrow" style="color:var(--blue)">ONLINE RESERVATION</p>
            <h2 class="title">THÔNG TIN <span>ĐẶT MÁY</span></h2>
          </div>
        </div>
        
        <div class="booking-grid">
          <!-- CỘT TRÁI: FORM ĐIỀN THÔNG TIN -->
          <div class="booking-form-wrap reveal">
            
            <div class="form-group">
              <label for="bName">Tên người đặt <span style="color:#ef4444">*</span></label>
              <input type="text" id="bName" placeholder="Tên của bạn" value="@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "")" required>
            </div>
            
            <div class="form-group">
              <label for="bPhone">Số điện thoại <span style="color:#ef4444">*</span></label>
              <input type="tel" id="bPhone" placeholder="SĐT liên hệ" pattern="[0-9]+" oninput="this.value = this.value.replace(/\s/g, '')" title="Vui lòng nhập số điện thoại (chỉ chứa số)" required>
            </div>

            <div class="form-group">
              <label for="bPeople">Số lượng người</label>
              <input type="number" id="bPeople" min="1" max="20" value="1" required>
            </div>

            <div class="form-group">
              <label for="bZone">Khu vực / Loại máy <span style="color:#ef4444">*</span></label>
              <select id="bZone" required>
                <option value="">-- Chọn khu vực --</option>
                @if (Model?.Zones != null)
                {
                    @foreach (var zone in Model.Zones)
                    {
                        var availCount = zone.Computers.Count(c => c.Status == "available");
                        <option value="@zone.ZoneId" data-price="@zone.PricePerHour" data-name="@zone.ZoneName">
                            @zone.ZoneName - @zone.PricePerHour.ToString("N0")đ/h (@availCount/@zone.Computers.Count máy rảnh)
                        </option>
                    }
                }
              </select>
            </div>
            
            <div class="form-group row-group">
              <div class="col-half">
                <label for="bDateTime">Thời gian bắt đầu</label>
                <input type="text" id="bDateTime" placeholder="Chọn ngày và giờ..." required>
              </div>
              <div class="col-half">
                <label for="bDuration">Thời gian chơi (Giờ)</label>
                <input type="number" id="bDuration" min="1" max="24" value="2" required>
              </div>
            </div>

            <div class="form-group">
              <label for="bPayment">Phương thức thanh toán</label>
              <select id="bPayment" required>
                <option value="counter">Thanh toán tại quầy</option>
                <option value="transfer">Chuyển khoản QR</option>
                @if (Model?.PaymentMethods != null)
                {
                    @foreach (var pm in Model.PaymentMethods)
                    {
                        if (pm.Code != "counter" && pm.Code != "transfer")
                        {
                            <option value="@pm.Code">@pm.Name</option>
                        }
                    }
                }
              </select>
            </div>
            
            <div style="margin-top: 30px; border-top: 1px solid var(--line); padding-top: 30px;">
              <div class="booking-control-panel" style="background: var(--card); border: none; border-radius: 12px; padding: 0; display: flex; flex-direction: column; gap: 15px;">
                <h3 style="font-size: 18px; color: #fff;">TÙY CHỌN DỊCH VỤ</h3>
                <div>
                  <button type="button" id="btnOpenFoodModal" class="btn" style="width: 100%; padding: 14px; background: #1a1e24; border: 1px solid #38404a; color: #fff; font-size: 13px; font-weight: 700; border-radius: 8px;">🍔 GỌI ĐỒ ĂN & TIỆN ÍCH</button>
                </div>
              </div>
            </div>
          </div>
          
          <!-- CỘT PHẢI: TỔNG QUAN & XÁC NHẬN -->
          <div class="booking-right reveal" style="display:flex;flex-direction:column;gap:30px">
            <div class="booking-summary-wrap" style="background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
              <div class="booking-summary" id="bSummary" style="flex: 1; margin-bottom: 12px; background: #0c0e12; border: 1px solid #2a2e36; padding: 24px; border-radius: 8px;">
                <h3 style="color: var(--blue2); font-size: 18px; margin-bottom: 15px; font-weight: 700;">TỔNG QUAN ĐẶT CHỖ</h3>
                <p style="color:#697079; font-size:14px">Vui lòng điền đủ thông tin để xem tạm tính.</p>
              </div>
              
              @if (User.Identity?.IsAuthenticated != true)
              {
                <div style="background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.3);padding:10px 14px;border-radius:8px;font-size:12px;color:#fca5a5;margin-bottom:12px;text-align:center">
                  🔒 Cần <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Home/Booking" style="color:var(--blue);text-decoration:underline;font-weight:700">Đăng nhập</a> để hoàn tất đặt chỗ.
                </div>
              }

              <div style="text-align: center;">
                <button type="submit" class="btn blue" id="bSubmitBtn" style="padding: 16px 30px; font-size: 16px; width: 100%; font-weight: 800; letter-spacing: 0.05em; border-radius: 8px;">XÁC NHẬN ĐẶT CHỖ</button>
              </div>
            </div>
          </div>
        </div> <!-- end booking-grid -->
      </form>
    </div>
  </section>
</main>

<!-- MODAL SƠ ĐỒ CHỌN MÁY -->
<div class="modal" id="seatModal">
  <div class="backdrop" data-close-seat></div>
  <div class="modal-box" style="width: min(800px, 100% - 30px); padding: 0; background: transparent; border: none;">
    <div class="seat-map-wrap" id="seatMapWrap">
      <!-- Rendered by JS -->
    </div>
  </div>
</div>

<!-- MODAL GỌI ĐỒ ĂN / TIỆN ÍCH -->
<div class="modal" id="foodModal">
  <div class="backdrop" data-close-food></div>
  <div class="modal-box" style="width: min(600px, 100% - 30px); padding: 0; background: transparent; border: none;">
    <div class="booking-menu-wrap" id="bookingMenuWrap" style="background:var(--card); border:1px solid var(--line); border-radius:12px; padding:25px; position: relative;">
      <button class="close" data-close-food style="top: 15px; right: 20px;">×</button>
      <h4 style="margin-bottom:20px; font-size:16px; color:#fff;">GỌI ĐỒ ĂN / TIỆN ÍCH</h4>
      <div id="bookingMenuList" style="display:grid;grid-template-columns:1fr;gap:10px;max-height:500px;overflow-y:auto;padding-right:5px">
        <!-- Rendered by JS -->
      </div>
      <div style="margin-top: 20px; text-align: center;">
        <button type="button" class="btn blue" data-close-food style="padding: 12px 30px; border-radius: 8px;">Xong</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL ĐẶT MÁY THÀNH CÔNG -->
<div class="modal" id="bookingSuccessModal">
  <div class="backdrop" data-close-success></div>
  <div class="modal-box" style="text-align: center; max-width: 440px; border-radius: 12px; padding: 35px 25px;">
    <button class="close" data-close-success>×</button>
    <p class="eyebrow" style="color:var(--blue2)">THÀNH CÔNG</p>
    <h2 style="font-size: 28px; margin: 10px 0 15px; line-height: 1.2;" id="successBookingId">ĐẶT MÁY THÀNH CÔNG</h2>
    <p style="color: #9097a1; font-size: 14px; line-height: 1.6; margin-bottom: 25px;" id="successBookingDetails">Thông tin đặt chỗ của bạn đã được ghi nhận. Vui lòng có mặt trước giờ đặt 15 phút.</p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a asp-controller="Home" asp-action="Index" class="btn blue" style="min-height: 44px; padding: 0 24px; font-size: 12px; font-weight: 800; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center;">VỀ TRANG CHỦ</a>
      <button type="button" class="btn" data-close-success style="min-height: 44px; padding: 0 20px; font-size: 12px; font-weight: 700; border-radius: 8px; background: #232830; color: #fff; display: inline-flex; align-items: center; justify-content: center;">ĐẶT CHỖ MỚI</button>
    </div>
  </div>
</div>

<!-- MODAL QUÉT MÃ QR THANH TOÁN -->
<div class="modal" id="qrModal">
  <div class="backdrop" data-close-qr></div>
  <div class="modal-box" style="text-align: center; max-width: 440px; border-radius: 12px; padding: 35px 25px;">
    <button class="close" data-close-qr>×</button>
    <p class="eyebrow" style="color:var(--blue2)">CHUYỂN KHOẢN</p>
    <h2 style="font-size: 26px; margin: 10px 0 15px;">QUÉT MÃ ĐỂ THANH TOÁN</h2>
    <div style="background:#fff;padding:16px;border-radius:12px;display:inline-block;margin:15px 0">
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=ThanhToanCyberGame" alt="QR Code" style="width:190px;height:190px;display:block;margin:auto">
    </div>
    <p style="font-size:15px;margin-bottom:20px">Tổng tiền: <strong id="qrTotalAmount" style="color:var(--blue2);font-size:20px">0 VNĐ</strong></p>
    <button class="btn blue" id="btnConfirmPayment" style="min-height: 46px; padding: 0 28px; font-size: 13px; font-weight: 800; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; width: 100%;">TÔI ĐÃ THANH TOÁN</button>
  </div>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const dtInput = document.getElementById("bDateTime");
      if (window.flatpickr && dtInput) {
        flatpickr("#bDateTime", {
          enableTime: true,
          dateFormat: "Y-m-d H:i",
          minDate: "today",
          time_24hr: true,
          defaultDate: new Date(Date.now() + 30 * 60000),
          onChange: function() {
            if (typeof window.saveBookingDraft === "function") window.saveBookingDraft();
          }
        });
      } else if (dtInput && !dtInput.value) {
        const now = new Date(Date.now() + 30 * 60000);
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        dtInput.value = now.toISOString().slice(0, 16);
      }
    });
  </script>
}
