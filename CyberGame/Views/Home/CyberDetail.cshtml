@model CyberGame.Models.Entities.Zone
@{
    ViewData["Title"] = "Chi tiết - " + (Model?.ZoneName ?? "Khu máy");
    var equipmentList = ViewBag.Equipment as List<CyberGame.Models.Entities.Equipment> ?? new List<CyberGame.Models.Entities.Equipment>();
    var zoneImg = (Model?.ZoneName?.Contains("VIP") == true)
        ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80"
        : (Model?.ZoneName?.Contains("Stream") == true || Model?.ZoneName?.Contains("Thi Đấu") == true)
        ? "https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1200&q=80"
        : (Model?.ZoneName?.Contains("Đôi") == true || Model?.ZoneName?.Contains("Couple") == true)
        ? "https://images.unsplash.com/photo-1598550476439-6847785fcea6?auto=format&fit=crop&w=1200&q=80"
        : "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1200&q=80";
}

<main id="cyberDetail">
<section class="detail-hero"><div class="container detail-grid">
  <div>
    <p class="eyebrow">CHI TIẾT KHU MÁY GAMING</p>
    <h1 id="detailName">@Model?.ZoneName</h1>
    <p id="detailAddress" style="color:var(--text-muted);font-size:14px;margin-top:8px">Đơn giá: <strong style="color:var(--blue);font-size:18px">@Model?.PricePerHour.ToString("N0") VNĐ/giờ</strong> | Tổng số máy: <strong>@Model?.Computers?.Count máy</strong></p>
  </div>
  <div class="detail-contact">
    <span>HOTLINE HỖ TRỢ</span>
    <strong id="detailPhone">090 123 4567</strong>
    <a class="btn blue" asp-controller="Home" asp-action="Booking" asp-route-zoneId="@Model?.ZoneId">ĐẶT MÁY NGAY →</a>
  </div>
</div></section>

<div class="detail-tabs"><div class="container tabs">
  <a class="active" href="#overview">TỔNG QUAN</a>
  <a href="#spec">CẤU HÌNH PHẦN CỨNG</a>
  <a href="#computers">DANH SÁCH MÁY</a>
  <a href="#equipment">THIẾT BỊ / GEAR</a>
</div></div>

<section id="overview"><div class="container">
  <div id="detailHeroImage" style="height:420px;background-image:url('@zoneImg');background-size:cover;background-position:center;border-radius:12px;border:1px solid var(--line)"></div>
</div></section>

<section class="light" id="spec" style="padding:50px 0"><div class="container">
  <p class="eyebrow">HARDWARE SPECIFICATIONS</p>
  <h2 class="title">THÔNG SỐ <span>KỸ THUẬT</span></h2>
  <div style="background:var(--card);border:1px solid var(--line);border-radius:12px;padding:30px;margin-top:25px">
    <h3 style="color:var(--blue);margin-bottom:15px;font-size:20px">@Model?.ZoneName</h3>
    <p style="color:#d1d5db;font-size:15px;line-height:1.8">@Model?.Specs</p>
  </div>
</div></section>

<section id="computers" style="padding:50px 0;background:#0d1015"><div class="container">
  <div class="section-head reveal">
    <div><p class="eyebrow">SƠ ĐỒ TRẠNG THÁI</p><h2 class="title">DANH SÁCH <span>MÁY TÍNH</span></h2></div>
    <span style="color:var(--text-muted);font-size:14px">Tổng: @Model?.Computers?.Count máy</span>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:15px;margin-top:25px">
    @if (Model?.Computers != null)
    {
        @foreach (var comp in Model.Computers)
        {
            var isAvail = comp.Status == "available";
            var color = isAvail ? "#10b981" : (comp.Status == "occupied" ? "#ef4444" : "#f59e0b");
            var statusText = isAvail ? "Trống" : (comp.Status == "occupied" ? "Đang chơi" : "Bảo trì");

            <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:15px;text-align:center">
              <div style="font-weight:700;font-size:16px;color:#fff;margin-bottom:6px">@comp.ComputerName</div>
              <span style="display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;background:rgba(255,255,255,0.05);color:@color">@statusText</span>
            </div>
        }
    }
  </div>
</div></section>

<section class="light" id="equipment" style="padding:50px 0"><div class="container">
  <div class="section-head reveal">
    <div><p class="eyebrow">GAMING GEAR</p><h2 class="title">TRANG THIẾT BỊ <span>ĐI KÈM</span></h2></div>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px;margin-top:25px">
    @if (equipmentList.Any())
    {
        @foreach (var eq in equipmentList)
        {
            <div style="background:var(--card);border:1px solid var(--line);border-radius:8px;padding:20px">
              <h4 style="color:#fff;font-size:16px;margin-bottom:8px">@eq.EquipmentName</h4>
              <p style="color:var(--text-muted);font-size:13px">Gắn tại: Máy #@eq.ComputerId</p>
              <p style="color:#10b981;font-size:12px;margin-top:8px">Tình trạng: @eq.ConditionStatus</p>
            </div>
        }
    }
    else
    {
        <p style="color:var(--text-muted)">Trang bị đầy đủ bàn phím cơ, chuột gaming cao cấp, tai nghe 7.1 theo tiêu chuẩn khu vực.</p>
    }
  </div>
</div></section>
</main>
